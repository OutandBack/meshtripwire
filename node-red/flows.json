[
    {
        "id": "broker1",
        "type": "mqtt-broker",
        "name": "meshtripwire broker",
        "broker": "mosquitto",
        "port": "1883",
        "clientid": "",
        "autoConnect": true,
        "usetls": false,
        "protocolVersion": "4",
        "keepalive": "60",
        "cleansession": true
    },
    {
        "id": "ui_base1",
        "type": "ui_base",
        "theme": {
            "name": "theme-light",
            "lightTheme": {"default": "#0094CE", "baseColor": "#0094CE", "baseFont": "-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Oxygen-Sans,Ubuntu,Cantarell,Helvetica Neue,sans-serif", "edited": false, "reset": false},
            "darkTheme": {"default": "#097479", "baseColor": "#097479", "baseFont": "-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Oxygen-Sans,Ubuntu,Cantarell,Helvetica Neue,sans-serif", "edited": false, "reset": false},
            "customTheme": {"name": "Untitled Theme 1", "default": "#4B7930", "baseColor": "#4B7930", "baseFont": "-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Oxygen-Sans,Ubuntu,Cantarell,Helvetica Neue,sans-serif"},
            "themeState": {
                "base-color": {"default": "#0094CE", "value": "#0094CE", "edited": false},
                "page-titlebar-backgroundColor": {"value": "#0094CE", "edited": false},
                "page-backgroundColor": {"value": "#fafafa", "edited": false},
                "page-sidebar-backgroundColor": {"value": "#ffffff", "edited": false},
                "group-textColor": {"value": "#1bbfff", "edited": false},
                "group-borderColor": {"value": "#ffffff", "edited": false},
                "group-backgroundColor": {"value": "#ffffff", "edited": false},
                "widget-textColor": {"value": "#111111", "edited": false},
                "widget-backgroundColor": {"value": "#0094ce", "edited": false},
                "widget-borderColor": {"value": "#ffffff", "edited": false},
                "base-font": {"value": "-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Oxygen-Sans,Ubuntu,Cantarell,Helvetica Neue,sans-serif"}
            },
            "angularTheme": {"primary": "indigo", "accents": "blue", "warn": "red", "background": "grey", "palette": "light"}
        },
        "site": {
            "name": "meshtripwire",
            "hideToolbar": "false",
            "allowSwipe": "false",
            "lockMenu": "false",
            "allowTempTheme": "true",
            "dateFormat": "DD/MM/YYYY",
            "sizes": {"sx": 48, "sy": 48, "gx": 6, "gy": 6, "cx": 6, "cy": 6, "px": 0, "py": 0}
        }
    },
    {
        "id": "ui_tab1",
        "type": "ui_tab",
        "name": "meshtripwire",
        "icon": "dashboard",
        "order": 1
    },
    {
        "id": "ui_group1",
        "type": "ui_group",
        "name": "Detections",
        "tab": "ui_tab1",
        "order": 1,
        "disp": true,
        "width": "8"
    },
    {
        "id": "mqtt_input",
        "type": "mqtt in",
        "z": "flow1",
        "name": "Meshtastic Data",
        "topic": "meshtastic/receive",
        "qos": "0",
        "datatype": "json",
        "broker": "broker1",
        "x": 120,
        "y": 100,
        "wires": [["rssi_filter"]]
    },
    {
        "id": "rssi_filter",
        "type": "function",
        "z": "flow1",
        "name": "RSSI filter (toggleable)",
        "func": "if (flow.get('strongOnly') && msg.payload.rssi < -75) { return null; }\nreturn msg;",
        "outputs": 1,
        "x": 310,
        "y": 100,
        "wires": [["log_mac", "ui_update", "ui_feed"]]
    },
    {
        "id": "filter_toggle",
        "type": "ui_switch",
        "z": "flow1",
        "name": "Strong signals only",
        "label": "Strong signals only",
        "group": "ui_group1",
        "order": 1,
        "onvalue": "true",
        "offvalue": "false",
        "x": 130,
        "y": 180,
        "wires": [["store_toggle"]]
    },
    {
        "id": "store_toggle",
        "type": "function",
        "z": "flow1",
        "name": "Store toggle",
        "func": "flow.set('strongOnly', msg.payload === 'true' || msg.payload === true);\nreturn null;",
        "outputs": 0,
        "x": 320,
        "y": 180,
        "wires": []
    },
    {
        "id": "log_mac",
        "type": "function",
        "z": "flow1",
        "name": "Format log line",
        "func": "var time = new Date().toISOString();\nmsg.payload = `${time} | ${msg.payload.from} | ${msg.payload.mac} | ${msg.payload.rssi} dBm`;\nreturn msg;",
        "outputs": 1,
        "x": 520,
        "y": 60,
        "wires": [["file_out"]]
    },
    {
        "id": "file_out",
        "type": "file",
        "z": "flow1",
        "name": "Log to file",
        "filename": "/data/sightings.log",
        "appendNewline": true,
        "overwriteFile": "false",
        "x": 700,
        "y": 60,
        "wires": [[]]
    },
    {
        "id": "ui_update",
        "type": "ui_text",
        "z": "flow1",
        "group": "ui_group1",
        "order": 2,
        "width": 0,
        "height": 0,
        "name": "Latest MAC",
        "label": "Latest:",
        "format": "{{msg.payload.mac}} via {{msg.payload.from}} ({{msg.payload.rssi}} dBm)",
        "x": 520,
        "y": 100
    },
    {
        "id": "ui_feed",
        "type": "function",
        "z": "flow1",
        "name": "Sightings feed (last 15)",
        "func": "var feed = flow.get('feed') || [];\nvar t = new Date().toLocaleTimeString();\nfeed.unshift(`${t}  ${msg.payload.mac}  via ${msg.payload.from}  ${msg.payload.rssi} dBm`);\nflow.set('feed', feed.slice(0, 15));\nmsg.payload = flow.get('feed').join('\\n');\nreturn msg;",
        "outputs": 1,
        "x": 520,
        "y": 140,
        "wires": [["ui_feed_text"]]
    },
    {
        "id": "ui_feed_text",
        "type": "ui_template",
        "z": "flow1",
        "group": "ui_group1",
        "name": "Recent sightings",
        "order": 3,
        "width": 0,
        "height": 0,
        "format": "<pre style=\"font-size:12px; white-space:pre-wrap; margin:0\">{{msg.payload}}</pre>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "x": 710,
        "y": 140
    },
    {
        "id": "flow1",
        "type": "tab",
        "label": "meshtripwire"
    }
]
